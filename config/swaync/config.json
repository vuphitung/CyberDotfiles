{
  "$schema": "/etc/xdg/swaync/configSchema.json",

  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "cssPriority": "application",

  "notification-window-width": 380,
  "notification-icon-size": 48,
  "notification-body-image-height": 80,
  "notification-body-image-width": 200,

  "control-center-width": 400,
  "control-center-margin-top": 8,
  "control-center-margin-right": 12,
  "control-center-margin-bottom": 12,

  "timeout": 5,
  "timeout-low": 3,
  "timeout-critical": 10,

  "fit-to-screen": false,
  "notification-2d-threshold": 0,
  "max-visible": 5,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 150,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,

  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Thông báo",
      "clear-all-button": true,
      "button-text": "Xóa hết"
    },
    "dnd": {
      "text": "Không làm phiền"
    },
    "volume": {
      "label": "Âm lượng",
      "show-per-app": false
    },
    "backlight": {
      "label": "Độ sáng"
    },
    "mpris": {
      "image-size": 56,
      "image-radius": 12
    },
    "buttons-grid": {
      "actions": [
        { "label": "Wi-Fi",      "command": "nm-connection-editor" },
        { "label": "Bluetooth",  "command": "blueman-manager" },
        { "label": "Khóa",       "command": "loginctl lock-session" },
        { "label": "Nguồn",      "command": "wlogout" }
      ]
    }
  }
}
