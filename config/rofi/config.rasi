// ╔══════════════════════════════════════════════════════════╗
// ║           CYBERTUNG — ROFI CONFIG v6                    ║
// ║           NEBULA CONTROL DECK · pywal auto-colors       ║
// ╚══════════════════════════════════════════════════════════╝

// ── IMPORT PYWAL COLORS (fallback: Nebula defaults below) ────
@import "~/.cache/wal/colors-rofi-dark.rasi"

// Nebula base overrides — pywal sets @background, @foreground, @color0-15.
// These only apply when pywal values are too bright or missing contrast.
* {
    nebula-bg:       #0a0a12ee;
    nebula-surface:  #12141fcc;
    nebula-cyan:     #00e5ff;
    nebula-violet:   #7c3aed;
    nebula-dim:      #4a5568;
    nebula-text:     #e2e8f0;
    border-radius:   0px;
}

// ── MAIN CONFIG ──────────────────────────────────────────────
configuration {
    modi:                   "drun,run,window";
    show-icons:             true;
    icon-theme:             "Papirus-Dark";
    display-drun:           " Apps";
    display-run:            " Run";
    display-window:         " Windows";
    drun-display-format:    "{name}";
    font:                   "JetBrainsMono Nerd Font 12";
    terminal:               "kitty";
    ssh-client:             "ssh";
    cycle:                  true;
    sidebar-mode:           true;
}

// ── WINDOW ───────────────────────────────────────────────────
window {
    width:            520px;
    transparency:     "real";
    background-color: @nebula-bg;
    border:           1px solid;
    border-color:     @nebula-cyan;
    border-radius:    16px;
    location:         center;
    x-offset:         0;
    y-offset:         -60px;
}

// ── MAINBOX ──────────────────────────────────────────────────
mainbox {
    children:         [ inputbar, listview, mode-switcher ];
    spacing:          0px;
    padding:          16px;
    background-color: transparent;
}

// ── INPUTBAR ─────────────────────────────────────────────────
inputbar {
    children:         [ prompt, entry ];
    background-color: @nebula-surface;
    border:           1px solid;
    border-color:     #1e293b;
    border-radius:    12px;
    padding:          10px 16px;
    margin:           0px 0px 12px 0px;
    spacing:          10px;
}

prompt {
    background-color: transparent;
    text-color:       @nebula-cyan;
    font:             "JetBrainsMono Nerd Font Bold 14";
    vertical-align:   0.5;
}

entry {
    background-color: transparent;
    text-color:       @nebula-text;
    placeholder:      "search...";
    placeholder-color: @nebula-dim;
    cursor:           text;
    vertical-align:   0.5;
}

// ── LISTVIEW ─────────────────────────────────────────────────
listview {
    lines:            8;
    columns:          1;
    spacing:          4px;
    padding:          4px 0px;
    background-color: transparent;
    scrollbar:        false;
    dynamic:          true;
    fixed-height:     false;
}

// ── ELEMENT ──────────────────────────────────────────────────
element {
    padding:          10px 14px;
    border-radius:    10px;
    background-color: transparent;
    text-color:       @foreground;
    spacing:          12px;
    orientation:      horizontal;
}

element selected.normal {
    background-color: @nebula-surface;
    text-color:       @nebula-text;
    border:           0px 0px 0px 3px solid;
    border-color:     @nebula-cyan;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @foreground;
}

element-icon {
    size:             22px;
    vertical-align:   0.5;
}

element-text {
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
}

// ── MODE SWITCHER ─────────────────────────────────────────────
mode-switcher {
    background-color: transparent;
    spacing:          6px;
    margin:           12px 0px 0px 0px;
}

button {
    background-color: @nebula-surface;
    text-color:       @nebula-dim;
    border:           1px solid;
    border-color:     #1e293b;
    border-radius:    10px;
    padding:          6px 14px;
}

button selected {
    background-color: @nebula-violet;
    text-color:       @nebula-text;
    border-color:     @nebula-violet;
}
