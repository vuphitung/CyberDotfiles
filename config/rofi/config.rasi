// ╔══════════════════════════════════════════════════════════╗
// ║           CYBERTUNG — ROFI CONFIG v5                    ║
// ║           pywal auto-colors + cyber style               ║
// ╚══════════════════════════════════════════════════════════╝

// ── IMPORT PYWAL COLORS ──────────────────────────────────────
@import "~/.cache/wal/colors-rofi-dark.rasi"

// ── MAIN CONFIG ──────────────────────────────────────────────
configuration {
    modi:                   "drun,run,window";
    show-icons:             true;
    icon-theme:             "Papirus-Dark";
    display-drun:           " Apps";
    display-run:            " Run";
    display-window:         " Windows";
    drun-display-format:    "{name}";
    font:                   "JetBrainsMono Nerd Font 12";
    terminal:               "kitty";
    ssh-client:             "ssh";
    cycle:                  true;
    sidebar-mode:           true;
}

// ── WINDOW ───────────────────────────────────────────────────
window {
    width:            480px;
    transparency:     "real";
    background-color: @background;
    border:           2px solid;
    border-color:     @color4;
    border-radius:    14px;
    location:         center;
    x-offset:         0;
    y-offset:         -60px;
}

// ── MAINBOX ──────────────────────────────────────────────────
mainbox {
    children:         [ inputbar, listview, mode-switcher ];
    spacing:          0px;
    padding:          12px;
    background-color: transparent;
}

// ── INPUTBAR ─────────────────────────────────────────────────
inputbar {
    children:         [ prompt, entry ];
    background-color: @color1;
    border-radius:    10px;
    padding:          8px 12px;
    margin:           0px 0px 10px 0px;
    spacing:          8px;
}

prompt {
    background-color: transparent;
    text-color:       @color4;
    font:             "JetBrainsMono Nerd Font Bold 13";
    vertical-align:   0.5;
}

entry {
    background-color: transparent;
    text-color:       @foreground;
    placeholder:      "tìm app...";
    placeholder-color: @color8;
    cursor:           text;
    vertical-align:   0.5;
}

// ── LISTVIEW ─────────────────────────────────────────────────
listview {
    lines:            8;
    columns:          1;
    spacing:          4px;
    padding:          4px 0px;
    background-color: transparent;
    scrollbar:        false;
    dynamic:          true;
    fixed-height:     false;
}

// ── ELEMENT ──────────────────────────────────────────────────
element {
    padding:          8px 12px;
    border-radius:    8px;
    background-color: transparent;
    text-color:       @foreground;
    spacing:          10px;
    orientation:      horizontal;
}

element selected.normal {
    background-color: @color2;
    text-color:       @foreground;
    border:           0px 0px 0px 2px solid;
    border-color:     @color4;
}

element-icon {
    size:             20px;
    vertical-align:   0.5;
}

element-text {
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
}

// ── MODE SWITCHER ─────────────────────────────────────────────
mode-switcher {
    background-color: transparent;
    spacing:          6px;
    margin:           8px 0px 0px 0px;
}

button {
    background-color: @color1;
    text-color:       @color8;
    border-radius:    8px;
    padding:          4px 12px;
}

button selected {
    background-color: @color4;
    text-color:       @background;
}
