// ╔══════════════════════════════════════════════════════════╗
// ║  ROFI — SAKURA GLASS                                     ║
// ║  Màu từ tokens.rasi (sinh từ themes/sakura-glass.json)   ║
// ╚══════════════════════════════════════════════════════════╝
// Kính mờ: layerrule "rofi" trong hyprland.conf (blur + ignore_alpha).

@import "~/.config/rofi/tokens.rasi"

configuration {
    modi:                   "drun,run,window";
    show-icons:             true;
    icon-theme:             "Papirus-Dark";
    display-drun:           "Apps";
    display-run:            "Run";
    display-window:         "Windows";
    drun-display-format:    "{name}";
    font:                   "Inter 12";
    terminal:               "kitty";
    cycle:                  true;
    sidebar-mode:           true;
}

window {
    width:            560px;
    transparency:     "real";
    location:         center;
    y-offset:         -60px;
    background-color: @glass-strong;
    border:           1px solid;
    border-color:     @specular;
    border-radius:    20px;
}

mainbox {
    children:         [ inputbar, listview, mode-switcher ];
    spacing:          0px;
    padding:          16px;
    background-color: transparent;
}

inputbar {
    children:         [ prompt, entry ];
    background-color: @glass-hi;
    border-radius:    14px;
    padding:          12px 16px;
    margin:           0px 0px 12px 0px;
    spacing:          10px;
}

prompt {
    background-color: transparent;
    text-color:       @pink;
    vertical-align:   0.5;
}

entry {
    background-color:  transparent;
    text-color:        @text;
    placeholder:       "Tìm kiếm...";
    placeholder-color: @text-muted;
    cursor:            text;
    vertical-align:    0.5;
}

listview {
    lines:            8;
    columns:          1;
    spacing:          4px;
    padding:          4px 0px;
    background-color: transparent;
    scrollbar:        false;
    dynamic:          true;
    fixed-height:     false;
}

element {
    padding:          10px 14px;
    border-radius:    12px;
    background-color: transparent;
    text-color:       @text;
    spacing:          12px;
    orientation:      horizontal;
}

element selected.normal {
    background-color: @pink-soft;
    text-color:       @text;
}

element-icon {
    size:             24px;
    vertical-align:   0.5;
}

element-text {
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
}

mode-switcher {
    background-color: transparent;
    spacing:          6px;
    margin:           12px 0px 0px 0px;
}

button {
    background-color: @glass-hi;
    text-color:       @text-muted;
    border-radius:    12px;
    padding:          8px 14px;
}

button selected {
    background-color: @pink-soft;
    text-color:       @pink;
}
